[
  {
    "name": "queue",
    "image": "php:8.5-fpm-bookworm",
    "repositoryCredentials": {
      "credentialsParameter": "arn:aws:secretsmanager:${region}:${account_id}:secret:mcury-web-prd-smg-dockerhub-credentials"
    },
    "cpu": 256,
    "memoryReservation": 512,
    "readonlyRootFilesystem": true,
    "entryPoint": [
      "/bin/sh"
    ],
    "command": [
      "-c",
      "php artisan queue:work --daemon --delay=1 --tries=10"
    ],
    "essential": true,
    "environment": [
      {
        "name": "PROJECT",
        "value": "${project}"
      },
      {
        "name": "ENV",
        "value": "${env}"
      }
    ],
    "logConfiguration": {
      "logDriver": "awsfirelens",
      "options": {
        "Name": "cloudwatch",
        "awslogs-region": "${region}",
        "awslogs-group": "${log_group_prefix}-cw-queue-cwlog",
        "auto-create-group": "true",
        "awslogs-stream-prefix": "queue"
      }
    },
    "ulimits": [
      {
        "softLimit": 1024000,
        "hardLimit": 1024000,
        "name": "nofile"
      }
    ]
  }
]
